Algoritmo secuencial5
	Definir num  Como Entero
	Definir circunferencia Como Real
	Definir circulo Como Real
	Definir esfera Como Real
	
	Escribir "Introduce un número: "
	Leer num
	
	circunferencia <- 2 * 3.14 * num
	Escribir "La longitud de la circunferencia es: ", circunferencia
	
	circulo <- 3.14 * num * num
	Escribir "El área del círculo es: ", circulo
	
	esfera <- (4/3) * 3.14 * num * num * num
	Escribir "El volumen de la esfera es: ", esfera
FinAlgoritmo
